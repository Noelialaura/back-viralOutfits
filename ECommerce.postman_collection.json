                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" } ],
            "url": "{{baseUrl}}/api/carrito"
          },
          "response": []
        },
        {
          "name": "Setup - Registrar segundo cliente",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Otro\",\n  \"apellido\": \"Cliente\",\n  \"email\": \"cliente2@uade.com\",\n  \"contrasena\": \"cliente123\"\n}"
            },
            "url": "{{baseUrl}}/auth/registro",
            "description": "Solo sirve para el caso siguiente: un cliente distinto al que hizo la compra."
          },
          "response": []
        },
        {
          "name": "Setup - Login segundo cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('tokenCliente2', pm.response.json().token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cliente2@uade.com\",\n  \"contrasena\": \"cliente123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "response": []
        },
        {
          "name": "403 - Cliente intenta ver el pedido de otro cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// La URL esta abierta al rol CLIENTE, pero PedidoService verifica que el",
                  "// pedido sea del usuario del token. Sin ese chequeo alcanzaria con probar ids.",
                  "pm.test('Status 403', function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{tokenCliente2}}" } ],
            "url": "{{baseUrl}}/api/pedidos/{{pedidoId}}"
          },
          "response": []
        },
        {
          "name": "400 - XSS bloqueado al crear un producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Sin el @Pattern de ProductoRequestDTO el script quedaria guardado en la base",
                  "// y volveria en cada GET del catalogo (XSS almacenado).",
                  "pm.test('Status 400', function () { pm.response.to.have.status(400); });",
                  "pm.test('El detalle explica el motivo', function () {",
                  "    pm.expect(pm.response.json().detalles.join(' ')).to.include('<');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"<script>alert('xss')</script>\",\n  \"descripcion\": \"<img src=x onerror=alert(1)>\",\n  \"precio\": 100,\n  \"marca\": \"UADE Wear\",\n  \"categoriaId\": {{categoriaId}}\n}"
            },
            "url": "{{baseUrl}}/api/productos"
          },
          "response": []
        },
        {
          "name": "400 - XSS bloqueado en la direccion de envio",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [ "pm.test('Status 400', function () { pm.response.to.have.status(400); });" ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenCliente}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"metodoPago\": \"TARJETA\",\n  \"direccionEnvio\": \"<script>document.cookie</script>\"\n}"
            },
            "url": "{{baseUrl}}/api/pedidos"
          },
          "response": []
        },
        {
          "name": "Cabeceras de seguridad en la respuesta",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Content-Security-Policy', function () {",
                  "    pm.response.to.have.header('Content-Security-Policy');",
                  "});",
                  "pm.test('X-Content-Type-Options: nosniff', function () {",
                  "    pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff');",
                  "});",
                  "pm.test('X-Frame-Options: DENY', function () {",
                  "    pm.expect(pm.response.headers.get('X-Frame-Options')).to.eql('DENY');",
                  "});"
                ]
              }
            }
          ],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/productos" },
          "response": []
        }
      ]
