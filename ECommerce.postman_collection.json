    {
      "name": "4 - Cliente (compra de punta a punta)",
      "description": "Flujo completo del comprador. El dueno del carrito y del pedido sale del token: no se manda ningun usuarioId en la URL ni en el body.",
      "item": [
        {
          "name": "Ver mi Perfil",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{tokenCliente}}" } ],
            "url": "{{baseUrl}}/usuarios/me"
          },
          "response": []
        },
        {
          "name": "Agregar Item al Carrito",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var items = pm.response.json().items;",
                  "    pm.collectionVariables.set('carritoItemId', items[items.length - 1].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenCliente}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"varianteProductoId\": {{varianteId}},\n  \"cantidad\": 2\n}"
            },
            "url": "{{baseUrl}}/api/carrito/items"
          },
          "response": []
        },
        {
          "name": "Ver mi Carrito",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{tokenCliente}}" } ],
            "url": "{{baseUrl}}/api/carrito"
          },
          "response": []
        },
        {
          "name": "Actualizar Cantidad del Item",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenCliente}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"cantidad\": 3\n}" },
            "url": "{{baseUrl}}/api/carrito/items/{{carritoItemId}}"
          },
          "response": []
        },
        {
          "name": "Confirmar Compra",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('pedidoId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenCliente}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"metodoPago\": \"TARJETA\",\n  \"direccionEnvio\": \"Lima 775, CABA\"\n}"
            },
            "url": "{{baseUrl}}/api/pedidos",
            "description": "Toma los items del carrito del usuario autenticado, descuenta stock y vacia el carrito."
          },
          "response": []
        },
        {
          "name": "Mis Pedidos",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{tokenCliente}}" } ],
            "url": "{{baseUrl}}/api/pedidos/mis-pedidos"
          },
          "response": []
        },
        {
          "name": "Ver Detalle de mi Pedido",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{tokenCliente}}" } ],
            "url": "{{baseUrl}}/api/pedidos/{{pedidoId}}",
            "description": "PedidoService valida que el pedido sea del usuario del token antes de devolverlo."
          },
          "response": []
        },
        {
          "name": "Admin - Cambiar Estado del Pedido",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"estadoPedido\": \"PAGADO\"\n}" },
            "url": "{{baseUrl}}/api/pedidos/{{pedidoId}}/estado"
          },
          "response": []
        },
        {
          "name": "Admin - Listar Pedidos por Estado",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" } ],
            "url": "{{baseUrl}}/api/pedidos?estado=PAGADO"
          },
          "response": []
        }
      ]
    },
    {
      "name": "5 - Casos de seguridad",
      "description": "Cada request de esta carpeta tiene que fallar con el codigo indicado en su nombre. Es la carpeta que demuestra la autenticacion, la autorizacion por rol y la proteccion contra XSS.",
      "item": [
        {
          "name": "401 - Ver carrito sin token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [ "pm.test('Status 401', function () { pm.response.to.have.status(401); });" ]
              }
            }
          ],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/carrito" },
          "response": []
        },
        {
          "name": "401 - Token invalido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [ "pm.test('Status 401', function () { pm.response.to.have.status(401); });" ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer token.falso.inventado" } ],
            "url": "{{baseUrl}}/api/carrito"
          },
          "response": []
        },
        {
          "name": "401 - Login con email inexistente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Mismo 401 y mismo mensaje que una contrasena incorrecta: la API no revela",
                  "// que emails estan registrados.",
                  "pm.test('Status 401', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"noexiste@uade.com\",\n  \"contrasena\": \"cualquiera\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "response": []
        },
        {
          "name": "401 - Login con contrasena incorrecta",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [ "pm.test('Status 401', function () { pm.response.to.have.status(401); });" ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cliente@uade.com\",\n  \"contrasena\": \"incorrecta\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "response": []
        },
