                "type": "text/javascript",
                "exec": [ "pm.test('Status 403', function () { pm.response.to.have.status(403); });" ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{tokenCliente}}" } ],
            "url": "{{baseUrl}}/usuarios"
          },
          "response": []
        },
        {
          "name": "403 - Admin intenta comprar (no tiene carrito)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
