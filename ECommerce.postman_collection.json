        {
          "name": "Obtener Producto por Id",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/productos/{{productoId}}" },
          "response": []
        },
        {
          "name": "Listar Variantes de un Producto",
          "request": {
            "method": "GET",
            "header": [],
